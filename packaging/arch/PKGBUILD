# Maintainer: Jeff Plumb <dark.tire0486@plumbmail.com>
# Upstream reference PKGBUILD. The AUR repository carries a copy of this file
# plus a generated .SRCINFO; see docs/AUR.md.

pkgname=plainrun
pkgver=0.2.1
pkgrel=1
pkgdesc='A simple native running log for Linux'
arch=('x86_64' 'aarch64')
url='https://github.com/pingskills/plainrun'
license=('MIT')
depends=('glibc' 'hicolor-icon-theme' 'libgcc' 'libstdc++' 'qt6-base' 'qt6-declarative')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real checksum once the v$pkgver tag is published: run `updpkgsums`.
sha256sums=('665205c0cff447daf6edcf15b6d34b7437326c86b5949ad82954dfd84b302686')

build() {
  cmake -B build -S "$pkgname-$pkgver" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DPLAINRUN_BUILD_TESTS=ON \
    -Wno-dev
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
